# Copy this file to `.env` and fill in the real values from Supabase.
# (.env is gitignored — never commit real credentials.)

# Supabase → Connect → ORMs → Prisma.
#
# Pick the endpoint to match how the app runs:
#  • Long-running server (local dev, `next dev`, a Node host): SESSION pooler
#    (port 5432) with a small connection_limit — persistent connections, no
#    churn. This is what we use locally:
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?connection_limit=5"
#  • Serverless (Vercel functions): TRANSACTION pooler (port 6543) instead, with
#    pgbouncer=true&connection_limit=1, e.g.
#    ...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Session pooler (port 5432) — used by `prisma migrate`:
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Auth.js session signing secret. Generate with: openssl rand -base64 33
AUTH_SECRET="generate-me"

# Mapbox public access token (mapbox.com → Account → Tokens). Browser-exposed,
# so restrict it by URL in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Secret for the cron sweep endpoint. Generate with: openssl rand -hex 16
# On Vercel, set this env var and Cron sends it automatically as a Bearer token.
CRON_SECRET="generate-me"

# Supabase Storage — for restaurant food/default image uploads (server-side
# only; the service-role key bypasses RLS, so never expose it to the browser).
# Both are in Supabase → Project Settings → API. The "food-images" bucket is
# created automatically on first upload.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Rate limiting (OPTIONAL). When set, limits are enforced in a shared store so
# they hold across all serverless instances on Vercel. Create a free database
# at upstash.com → Redis, then copy its REST URL + token here. If left blank,
# the app falls back to a per-instance in-memory limiter (fine for local dev /
# a single host; weaker across multiple Vercel instances). The limiter always
# fails open, so a missing or unreachable store never blocks real users.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
