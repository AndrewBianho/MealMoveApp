# Copy this file to `.env` and fill in the real values from Supabase.
# (.env is gitignored — never commit real credentials.)

# Supabase → Connect → ORMs → Prisma.
#
# Pick the endpoint to match how the app runs:
#  • Long-running server (local dev, `next dev`, a Node host): SESSION pooler
#    (port 5432) with a small connection_limit — persistent connections, no
#    churn. This is what we use locally:
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?connection_limit=5"
#  • Serverless (Vercel functions): TRANSACTION pooler (port 6543) instead, with
#    pgbouncer=true&connection_limit=1, e.g.
#    ...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Session pooler (port 5432) — used by `prisma migrate`:
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Auth.js session signing secret. Generate with: openssl rand -base64 33
AUTH_SECRET="generate-me"

# Mapbox public access token (mapbox.com → Account → Tokens). Browser-exposed,
# so restrict it by URL in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Mapbox token for SERVER-side geocoding (restaurant address → map pin), used at
# sign-up and by prisma/backfill-geocode.ts. Optional: if unset, the public
# token above is used. Prefer a separate token here with NO URL restriction
# (server requests send no referrer) — restricting it to the Geocoding scope is
# enough. Unset entirely → new restaurants fall back to campus center.
MAPBOX_TOKEN=""

# Secret for the cron sweep endpoint. Generate with: openssl rand -hex 16
# On Vercel, set this env var and Cron sends it automatically as a Bearer token.
CRON_SECRET="generate-me"

# Supabase Storage — for restaurant food/default image uploads (server-side
# only; the service-role key bypasses RLS, so never expose it to the browser).
# Both are in Supabase → Project Settings → API. The "food-images" bucket is
# created automatically on first upload.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Password-reset email (OPTIONAL). The reset flow always works: with these
# unset, the reset link is logged to the server console (fine for local dev).
# Set them to send real email over SMTP — free options include a Gmail account
# with an app password, or your campus mail server. APP_URL pins the absolute
# link host (otherwise it's derived from the incoming request).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Meal Move <no-reply@mealmove.app>"
APP_URL=""

# Rate limiting (OPTIONAL). When set, limits are enforced in a shared store so
# they hold across all serverless instances on Vercel. Create a free database
# at upstash.com → Redis, then copy its REST URL + token here. If left blank,
# the app falls back to a per-instance in-memory limiter (fine for local dev /
# a single host; weaker across multiple Vercel instances). The limiter always
# fails open, so a missing or unreachable store never blocks real users.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Push notifications via Firebase Cloud Messaging (OPTIONAL). Powers pickup
# nudges, buddy invites, and drop-off notices as web push, with email (SMTP
# above) as the fallback for users without a registered device. Everything
# degrades gracefully: leave these unset and push is simply skipped — opt-in
# still records the user and notices flow over email. Create a project at
# console.firebase.google.com, then enable Cloud Messaging.
#
# Browser SDK config — Firebase console → Project settings → General → "Your
# apps" (Web app). Public by design (shipped to the client), so safe to expose.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="PROJECT_ID.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="PROJECT_ID"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Web Push certificate key pair — Firebase console → Project settings → Cloud
# Messaging → "Web configuration" → Web Push certificates. Identifies this app
# to the browser push service when requesting a device token.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
#
# Admin SDK service account (SERVER-side only — grants send access; never expose
# to the browser). Firebase console → Project settings → Service accounts →
# "Generate new private key", then copy these three fields from the JSON.
# FIREBASE_PRIVATE_KEY contains literal "\n" escapes — keep it quoted on one line.
FIREBASE_PROJECT_ID="PROJECT_ID"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@PROJECT_ID.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# NOTE: the service worker public/firebase-messaging-sw.js can't read these env
# vars (service workers have no process.env), so it ships with literal
# REPLACE_NEXT_PUBLIC_FIREBASE_* placeholders you must hand-edit to the same
# values above before push works in a deployed build.

# Analytics (PostHog) — leave blank to disable (all tracking no-ops)
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
