#!/bin/sh
#
# Blocks a push that would fail the Vercel build.
#
# Vercel runs `next build`, which runs ESLint as a hard gate. A lint ERROR there
# fails the deploy — but because Vercel keeps serving the last good deployment,
# the failure is invisible until you try to do something that needs a healthy
# one (like assigning a domain). That is exactly how `useDemo` sat broken for
# 21 hours.
#
# Lint is the gate here rather than a full build: it catches that class of
# failure in seconds instead of minutes, so the hook stays worth keeping.
#
# Bypass for a genuine emergency:  git push --no-verify

set -e

echo "pre-push: running next lint…"

if ! npx --no-install next lint; then
  echo
  echo "pre-push: BLOCKED — lint failed."
  echo "These are the same errors that will fail the Vercel build."
  echo "Fix them, or push with --no-verify if you accept a failed deploy."
  exit 1
fi

echo "pre-push: lint clean."
exit 0
