// Meal Move — data model.
// Designed around the two core problems: volunteer flaking (claims are holds
// with deadlines; reliability is computed from real events) and loss of
// institutional memory (everything durable, ListingEvent is an append-only log).

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (6543) — used by the app
  directUrl = env("DIRECT_URL") // direct (5432) — used by migrations
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  volunteer
  restaurant
  drop_off_admin
  org_admin
}

enum ListingStatus {
  open
  claimed
  in_transit
  // Volunteer has the food but couldn't deliver today — kept overnight to drop
  // off the next day. A deferred rescue, not a flake (never auto-expired).
  taken_home
  delivered
  expired
  failed
}

// What a listing is, so it can be matched to drop-offs that can hold it.
enum FoodCategory {
  prepared
  produce
  bakery
  packaged
  dairy
  beverages
}

// How this food must be kept while it's in transit — a safety signal for the
// volunteer (and the proof checklist at pickup). null = unspecified.
enum TempHandling {
  hot
  cold
  ambient
}

// The volunteer's one-tap "rescue accuracy" signal after a delivery: was the
// food present and roughly as described? An operations metric (private to
// org-admin + the restaurant), never a public leaderboard — see Pickup.
enum RescueAccuracy {
  yes // present and as described
  partly // there, but off (less than posted, different food)
  no // not there / unusable
}

// Lifecycle of a buddy invite — one volunteer asking another to do a pickup
// together. Pending until the invitee responds; cancelled if the inviter pulls it.
enum BuddyInviteStatus {
  pending
  accepted
  declined
  cancelled
}

// Which world an account sees and acts in. Demo is a curated, fully interactive
// sample (for showing the app off / handing it to next year's leaders); real is
// the chapter's live data. Every data-bearing row carries a matching `demo` flag
// so the two worlds never mix.
enum DataMode {
  real
  demo
}

// Whether an account is usable yet. Volunteers (and admin-invited teammates) are
// `active` on creation; a self-serve restaurant or drop-off sign-up starts
// `pending` and can't sign in until an org admin approves it. The matching
// Restaurant/DropOff row isn't created until approval (see User.pendingOrg), so
// an unapproved partner has nothing operational in the system.
enum AccountStatus {
  pending
  active
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  phone        String? // contact number for pickup coordination; never shown to admins
  role         Role          @default(volunteer)
  status       AccountStatus @default(active)
  // For a pending restaurant/drop-off account: the org/location captured at
  // sign-up, held until an org admin approves. Cleared on approval (the real
  // Restaurant/DropOff row is created then). Shape:
  // { kind: "restaurant" | "drop_off", name: string, address: string }.
  pendingOrg   Json?
  passwordHash String? // bcrypt hash for the Credentials provider
  dataMode     DataMode      @default(real) // which world this account sees/acts in
  restaurant   Restaurant?   @relation(fields: [restaurantId], references: [id])
  restaurantId String?
  pickups      Pickup[]
  buddyPickups Pickup[]    @relation("PickupBuddy") // pickups where this user is the second seat
  events       ListingEvent[]
  messages      Message[]
  buddyInvitesSent     BuddyInvite[] @relation("InviteInviter")
  buddyInvitesReceived BuddyInvite[] @relation("InviteInvitee")
  adminActions  AdminEvent[] @relation("AdminActor")
  adminTargeted AdminEvent[] @relation("AdminTarget")
  passwordResetTokens  PasswordResetToken[]
  dropOffNotices       DropOffNotice[]
  notificationsEnabled Boolean       @default(false)
  // Quiet hours: don't send push/email between these local hours (0–23). Both
  // null = always on. Wraps midnight when start > end (e.g. 22 → 7). A single
  // chapter-local clock — no per-user timezone is tracked.
  quietHoursStart      Int?
  quietHoursEnd        Int?
  notifyPrimedAt       DateTime?
  deviceTokens         DeviceToken[]
  // Volunteer's rough position, used to target escalating broadcasts and to
  // show restaurants how many volunteers are active nearby. Optional — a
  // volunteer without a position simply isn't distance-targeted.
  lat                  Float?
  lng                  Float?
  broadcasts           ListingBroadcast[]
  createdAt            DateTime      @default(now())

  @@index([status]) // the org-admin pending-approval queue
}

// Single-use, time-boxed tokens for the email password-reset flow. Only the
// sha256 hash of the token is stored — the raw token lives solely in the emailed
// link, so a database leak can't be replayed to seize accounts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  tokenHash String    @unique // sha256 of the raw token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Restaurant {
  id        String        @id @default(cuid())
  name      String
  address   String
  lat       Float
  lng       Float
  imageUrl  String? // default image, shown on a card when the listing has no food photo
  demo      Boolean       @default(false) // belongs to the curated demo world, not real data
  // Relationship memory for handoff — the human know-how that otherwise leaves
  // when founders graduate. Org-admin editable; not shown to volunteers.
  primaryContact String?   // who to talk to ("Maria, closing manager")
  contactInfo    String?   // how to reach them (phone / email, free-form)
  lastContactAt  DateTime? // when the org last spoke with them
  quirks         String?   // free-text notes ("bring a cooler bag", "dead on Tuesdays")
  members   User[]
  listings  FoodListing[]
  recurringPosts RecurringPost[]
  createdAt DateTime      @default(now())
}

// A restaurant's standing surplus schedule — "every weekday at 8pm",
// "Mon & Thu at 6pm", "daily". A generator (lib/recurring + the sweep cron)
// materializes upcoming FoodListings from each active schedule, ahead of time,
// so volunteers can see future pickups. daysOfWeek uses JS getDay(): 0 = Sunday
// … 6 = Saturday (daily = all 7; weekly = a single day; specific = any subset).
model RecurringPost {
  id            String        @id @default(cuid())
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  restaurantId  String
  // Template copied onto each generated listing.
  title         String
  servings      Int
  weightLbs     Float?
  category      FoodCategory  @default(prepared)
  perishable    Boolean       @default(false)
  notes         String?
  imageUrl      String?
  // Recurrence.
  daysOfWeek    Int[] // 0=Sun … 6=Sat
  timeOfDay     Int // minutes from local midnight (0–1439) when it goes live
  windowMinutes Int           @default(120) // how long the pickup window stays open once live
  active        Boolean       @default(true)
  demo          Boolean       @default(false)
  listings      FoodListing[]
  createdAt     DateTime      @default(now())

  @@index([active])
}

model DropOff {
  id        String        @id @default(cuid())
  name      String
  address   String
  lat       Float
  lng       Float
  // Constraints on what this location can actually take in.
  acceptedCategories FoodCategory[]
  refrigerated       Boolean        @default(false) // can hold perishable/cold
  capacity           Int            @default(100) // max servings it can hold
  notes              String? // human-readable restrictions (allergens, hours…)
  retrievalHours     Json? // RetrievalHours: per-weekday food-retrieval windows (see lib/hours.ts)
  demo               Boolean        @default(false) // belongs to the curated demo world, not real data
  // Relationship memory for handoff — org-admin editable contacts & quirks that
  // survive founder turnover. Not shown to volunteers. Mirrors Restaurant.
  primaryContact String?
  contactInfo    String?
  lastContactAt  DateTime?
  quirks         String?
  listings  FoodListing[]
  notices   DropOffNotice[]
  createdAt DateTime      @default(now())
}

// What a service notice is about — drives the icon/label volunteers see.
enum DropOffNoticeKind {
  hours // a change to the normal open / retrieval hours
  conditions // a change to normal conditions (capacity, refrigeration, access)
  general
}

// A temporary service notice a drop-off posts when its normal hours or
// conditions change ("closing at 6 today", "fridge down this week", "use the
// side door"). Distinct from the standing `notes` / `retrievalHours`: it's
// dated and clears itself once `until` passes (null = until removed). Surfaced
// to volunteers wherever the drop-off appears.
model DropOffNotice {
  id        String            @id @default(cuid())
  dropOff   DropOff           @relation(fields: [dropOffId], references: [id])
  dropOffId String
  author    User              @relation(fields: [authorId], references: [id])
  authorId  String
  kind      DropOffNoticeKind @default(general)
  body      String
  until     DateTime? // auto-expires after this; null = stays until removed
  demo      Boolean           @default(false)
  createdAt DateTime          @default(now())

  @@index([dropOffId, createdAt])
}

model FoodListing {
  id           String         @id @default(cuid())
  title        String
  servings     Int
  weightLbs    Float? // actual weight if the restaurant provides it
  category     FoodCategory   @default(prepared)
  perishable   Boolean        @default(false)
  // Food-safety surfacing: allergens present (free-form labels) and how the food
  // must be kept in transit. Both optional — older listings predate them.
  allergens    String[]       @default([])
  tempHandling TempHandling?
  imageUrl     String? // photo of this specific food; takes priority over the restaurant's default
  notes        String? // special requests / restraints from the restaurant
  demo         Boolean        @default(false) // belongs to the curated demo world, not real data
  status       ListingStatus  @default(open)
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id])
  restaurantId String
  dropOff      DropOff?       @relation(fields: [dropOffId], references: [id])
  dropOffId    String?
  // When a scheduled/future listing becomes claimable. null = available now
  // (a normal one-off post). Until this passes, the listing is visible but
  // locked (see claimListing); the generator that creates it lives in
  // lib/recurring.
  availableAt  DateTime?
  recurringPost   RecurringPost? @relation(fields: [recurringPostId], references: [id])
  recurringPostId String?
  postedAt     DateTime       @default(now())
  expiresAt    DateTime // real timestamp — "minutes left" is derived from this
  pickup       Pickup?
  events       ListingEvent[]
  messages     Message[]
  buddyInvites BuddyInvite[]
  broadcasts   ListingBroadcast[]

  @@index([demo, status, expiresAt])
  @@index([recurringPostId, availableAt])
}

model Pickup {
  id          String      @id @default(cuid())
  listing     FoodListing @relation(fields: [listingId], references: [id])
  listingId   String      @unique
  volunteer   User        @relation(fields: [volunteerId], references: [id])
  volunteerId String
  // Optional second volunteer doing this pickup together — the buddy. If the
  // primary bails, the buddy is promoted to volunteerId so the food still gets
  // rescued (partner covers solo).
  buddy       User?       @relation("PickupBuddy", fields: [buddyId], references: [id])
  buddyId     String?
  claimedAt   DateTime    @default(now())
  holdUntil   DateTime // the 15-min hold; a cron releases claims past this
  deliveredAt DateTime?
  takenHomeAt DateTime? // set when the volunteer kept the food to deliver next day
  deliverBy   DateTime? // gentle next-day deadline for a taken-home pickup (display + nudge)
  lastCheckInAt DateTime? // last "still on it" confirmation; suppresses re-prompting
  nudgesSent    Int       @default(0) // count of 5-min check-up nudges the cron has dispatched (0–2)
  // Proof photos the volunteer captures — required to advance the claim.
  photoAtPickupUrl   String? // food photo taken leaving the restaurant (claimed → in_transit)
  photoAtDeliveryUrl String? // food photo taken at the drop-off (in_transit → delivered)
  // Answers to the dismissible food-safety checklist captured at the pickup
  // proof step, e.g. { tempKept: true, underTwoHours: true, sealed: false }.
  // Json so the question set can evolve without a migration.
  safetyChecklist    Json?
  // The volunteer's post-delivery "rescue accuracy" signal — was the food there
  // and as described? Symmetry to the volunteer reliability meter, but kept
  // private (org-admin + the restaurant only), never a public leaderboard.
  rescueAccuracy     RescueAccuracy?
  rescueAccuracyNote String?

  @@index([volunteerId])
  @@index([buddyId])
}

// One volunteer inviting another to do a specific pickup together. Pending until
// the invitee responds; on accept the invitee becomes the Pickup's buddy.
model BuddyInvite {
  id          String            @id @default(cuid())
  listing     FoodListing       @relation(fields: [listingId], references: [id])
  listingId   String
  inviter     User              @relation("InviteInviter", fields: [inviterId], references: [id])
  inviterId   String
  invitee     User              @relation("InviteInvitee", fields: [inviteeId], references: [id])
  inviteeId   String
  status      BuddyInviteStatus @default(pending)
  createdAt   DateTime          @default(now())
  respondedAt DateTime?

  @@unique([listingId, inviteeId]) // at most one invite per person per listing
  @@index([inviteeId, status]) // a volunteer's pending invites
}

// Append-only log of admin actions (role changes) — who granted authority to
// whom, and when. The institutional record that survives founder turnover.
model AdminEvent {
  id       String   @id @default(cuid())
  type     String // role_changed | account_approved | notes_edited
  actor    User     @relation("AdminActor", fields: [actorId], references: [id])
  actorId  String
  // The user this action was about, when there is one. Null for actions that
  // target an org entity instead (e.g. editing a restaurant/drop-off's notes),
  // whose subject lives in meta as { entity, entityId, name }.
  target   User?    @relation("AdminTarget", fields: [targetId], references: [id])
  targetId String?
  meta     Json?
  at       DateTime @default(now())

  @@index([targetId, at])
}

// Append-only audit trail — the chapter's institutional memory.
model ListingEvent {
  id        String      @id @default(cuid())
  listing   FoodListing @relation(fields: [listingId], references: [id])
  listingId String
  type      String // posted | claimed | in_transit | taken_home | delivered | expired | released | failed
  actor     User?       @relation(fields: [actorId], references: [id])
  actorId   String?
  meta      Json?
  at        DateTime    @default(now())

  @@index([listingId, at])
}

// One shared coordination thread per claim, keyed by listing (Pickup is 1:1
// with FoodListing). Joins the volunteer, the restaurant, and the drop-off
// while the claim is active; goes read-only once it ends.
model Message {
  id        String      @id @default(cuid())
  listing   FoodListing @relation(fields: [listingId], references: [id])
  listingId String
  sender    User        @relation(fields: [senderId], references: [id])
  senderId  String
  body      String
  createdAt DateTime    @default(now())

  @@index([listingId, createdAt])
}

// Pending invitation for a new account to join an existing organization.
// Restaurant invites carry the target restaurantId; drop-off invites leave it
// null (drop-off admins are chapter-wide). Consumed at sign-up by registerUser.
model TeamInvite {
  id           String    @id @default(cuid())
  email        String // lowercased invitee email
  role         Role // restaurant | drop_off_admin
  restaurantId String? // set for restaurant invites; null = chapter-wide drop-off
  invitedById  String? // inviter user id (scalar — no FK, keeps the migration small)
  status       String    @default("pending") // pending | accepted | cancelled
  createdAt    DateTime  @default(now())
  respondedAt  DateTime?

  @@index([email, status])
}

// FCM device token registered by a volunteer to receive push notifications.
// One user may have multiple tokens (different devices / browsers). Tokens are
// upserted on each FCM registration and pruned when FCM reports them invalid.
model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// Sent-state for escalating broadcasts: one row per (listing, volunteer, band),
// so the sweep never pings the same volunteer twice about the same listing in
// the same time-left band. See lib/broadcast.ts.
model ListingBroadcast {
  id          String      @id @default(cuid())
  listing     FoodListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId   String
  volunteer   User        @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  volunteerId String
  band        String // "open" | "soon" | "closing_soon"
  sentAt      DateTime    @default(now())

  @@unique([listingId, volunteerId, band])
  @@index([listingId])
}
