{
  "name": "mealmove",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:demo:reset": "node --env-file=.env --import tsx prisma/reset-demo.ts",
    "db:studio": "prisma studio",
    "make-admin": "node --env-file=.env --import tsx scripts/make-admin.ts",
    "db:promote-super-admin": "node --env-file=.env --import tsx scripts/promote-super-admin.ts",
    "sweep": "node --env-file=.env --import tsx scripts/sweep.ts",
    "test": "node --require ./lib/stub-server-only.cjs --import tsx --test lib/*.test.ts lib/analytics/*.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.107.0",
    "bcryptjs": "^3.0.3",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.0.0",
    "mapbox-gl": "^3.24.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^9.0.1",
    "posthog-js": "^1.399.2",
    "posthog-node": "^5.41.0",
    "prisma": "^6.19.3",
    "react": "^18",
    "react-dom": "^18",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8",
    "process": "^0.11.10",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
